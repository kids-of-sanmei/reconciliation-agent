# 默认保存到 backend/.data，也可配置绝对存储路径。
# RECONCILIATION_STORAGE_ROOT=S:/ai-agent/reconciliation/backend/.data
RECONCILIATION_MAX_UPLOAD_BYTES=20971520

# 陌生表结构由模型辅助识别；本机 Ollama 不需要 API Key。
# 复制为 .env 后，启用下列 Ollama 配置即可。
# RECONCILIATION_LLM_PROVIDER=ollama
# RECONCILIATION_LLM_MODEL=qwen3.5:9b
# RECONCILIATION_LLM_BASE_URL=http://127.0.0.1:11434
# RECONCILIATION_LLM_TIMEOUT_SECONDS=180
# RECONCILIATION_LLM_CONTEXT_TOKENS=16384

# 兼容云端接口（默认 provider 为 openai）。
# RECONCILIATION_LLM_PROVIDER=openai
# RECONCILIATION_LLM_MODEL=配置实际模型名称
# RECONCILIATION_LLM_API_KEY=配置实际密钥
# RECONCILIATION_LLM_BASE_URL=配置兼容接口地址
